# GitHub workflows (if private)
.github/
# ...but keep the control-plane hardening CI workflow tracked (PR 4.4a-3) despite
# the blanket .github/ ignore above. Re-including a nested file requires
# re-admitting each parent directory, then re-excluding its other contents. These
# are ROOT-ANCHORED (leading slash) so ONLY this repo-root workflow becomes
# trackable and nested service-level .github/ dirs stay ignored.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/control-plane-hardening-tests.yml

# Roo framework
.roo/

# TaskMaster
.taskmaster/

# VSCode settings (already included above but adding for clarity)
.vscode/

# Claude conversations and logs
claude-conversations/

# CSV exports
csv_exports/

# Debug utilities
debug-utils/

# Documentation (if auto-generated)
docs/

# Application logs (already included above but adding for clarity)
logs/

# Kubernetes manifests (if private)
k8s/

# Mobile applications
mobile-apps/

# Scripts (if private)
scripts/
# flow-monitoring keeps provenance/generator scripts tracked (Wave 1.8)
!services/flow-monitoring/scripts/

# Only the approved, content-addressed SCADA workbook is a tracked build input.
services/flow-monitoring/data/sources/scada/*
!services/flow-monitoring/data/sources/scada/SCADA Section Detailed Information 2026-07-14 V2.0 SL.xlsx
!services/flow-monitoring/scripts/**

# ROS-GIS pins the approved hybrid section-master workbook by content hash.
!services/ros-gis-integration/data/sources/
!services/ros-gis-integration/data/sources/SCADA Section Detailed Information 2026-07-24 V5.0 SL.xlsx

