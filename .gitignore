venv/
venv_aos_export/

# Claude session logs
docs/claude-sessions/
!docs/claude-sessions/README.md
# Local UI scratch files
frontend-test.html

# Track hand-authored flow-monitoring remediation docs (exception to docs/ ignore above)
!services/flow-monitoring/docs/
services/flow-monitoring/docs/*
!services/flow-monitoring/docs/remediation/
!services/flow-monitoring/docs/remediation/**

# Track the flow-monitoring test suite (exception to the blanket tests/ ignore above)
!services/flow-monitoring/tests/
!services/flow-monitoring/tests/**

# Track the bff-water-planning test suite (Wave 2.6a boot-restoration gate)
!services/bff-water-planning/tests/
!services/bff-water-planning/tests/**

# Track the ros-gis-integration test suite (Wave 2.6b fail-closed gate)
!services/ros-gis-integration/tests/
!services/ros-gis-integration/tests/**

# Track ros-gis-integration schema migrations (Wave 2.5 dataset-version parent).
# Exact allowlist exception to the blanket *.sql credential guard above.
!services/ros-gis-integration/migrations/
services/ros-gis-integration/migrations/*
!services/ros-gis-integration/migrations/__init__.py
!services/ros-gis-integration/migrations/migrate.py
!services/ros-gis-integration/migrations/*.up.sql
!services/ros-gis-integration/migrations/*.down.sql

# Track flow-monitoring schema migrations (PR 4.1 prediction persistence).
# Exact allowlist exception to the blanket *.sql credential guard above.
!services/flow-monitoring/migrations/
services/flow-monitoring/migrations/*
!services/flow-monitoring/migrations/__init__.py
!services/flow-monitoring/migrations/migrate.py
!services/flow-monitoring/migrations/*.up.sql
!services/flow-monitoring/migrations/*.down.sql

# Track the scheduler test suite normally (PR 4.2 foundation) — it was
# partially force-staged under the blanket tests/ rule above.
!services/scheduler/tests/
!services/scheduler/tests/**
!services/scheduler/pytest.ini
# scripts: EXACT allowlist (the two ops probes) — a blanket scripts/**
# re-include would strip the credential guards below.
!services/scheduler/scripts/
services/scheduler/scripts/*
!services/scheduler/scripts/ops/
services/scheduler/scripts/ops/*
!services/scheduler/scripts/ops/ec2_connection_probe.py
!services/scheduler/scripts/ops/ec2_scheduler_api_probe.py
# Re-assert the credential guards INSIDE the re-included tests tree
# (last-match-wins: the negation above would otherwise make secret-shaped
# files trackable — this repo has committed-credential history).
services/scheduler/tests/**/.env*
services/scheduler/tests/**/*.pem
services/scheduler/tests/**/*.key
services/scheduler/tests/**/*.sql

# Track scheduler schema migrations (PR 4.2 runner; pairs arrive with their
# consuming PRs). Exact allowlist exception to the blanket *.sql guard above.
!services/scheduler/migrations/
services/scheduler/migrations/*
!services/scheduler/migrations/__init__.py
!services/scheduler/migrations/migrate.py
!services/scheduler/migrations/*.up.sql
!services/scheduler/migrations/*.down.sql

# Compiled python artifacts must never be tracked, even inside re-included trees
# (gitignore is last-match-wins; keep these at the END of the file). Wave 1.8.
**/__pycache__/
**/*.py[cod]
