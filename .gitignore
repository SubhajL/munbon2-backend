# Track hand-authored flow-monitoring remediation docs (exception to docs/ ignore above)
!services/flow-monitoring/docs/
services/flow-monitoring/docs/*
!services/flow-monitoring/docs/remediation/
!services/flow-monitoring/docs/remediation/**

# Track the flow-monitoring test suite (exception to the blanket tests/ ignore above)
!services/flow-monitoring/tests/
!services/flow-monitoring/tests/**

# Track the bff-water-planning test suite (Wave 2.6a boot-restoration gate)
!services/bff-water-planning/tests/
!services/bff-water-planning/tests/**

# Track the ros-gis-integration test suite (Wave 2.6b fail-closed gate)
!services/ros-gis-integration/tests/
!services/ros-gis-integration/tests/**

# Compiled python artifacts must never be tracked, even inside re-included trees
# (gitignore is last-match-wins; keep these at the END of the file). Wave 1.8.
**/__pycache__/
**/*.py[cod]
