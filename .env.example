# EC2 Configuration (CENTRAL - Update IP here for entire codebase)
EC2_HOST=43.208.201.191
EC2_SSH_KEY_PATH=./th-lab01.pem
EC2_SSH_USER=ubuntu

# EC2 Database Configuration
DB_HOST=${EC2_HOST}
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<CHANGE-THIS-STRONG-PASSWORD>
DB_NAME=postgres
DB_NAME_SENSOR_DATA=sensor_data

# PostgreSQL Database URL (for Prisma)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# TimescaleDB Configuration (on same EC2)
TIMESCALE_HOST=${EC2_HOST}
TIMESCALE_PORT=5432
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=<CHANGE-THIS-STRONG-PASSWORD>
TIMESCALE_DB=sensor_data

# Database URLs (for convenience)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${EC2_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
TIMESCALE_URL=postgresql://${TIMESCALE_USER}:${TIMESCALE_PASSWORD}@${EC2_HOST}:${TIMESCALE_PORT}/${TIMESCALE_DB}

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=<YOUR-AWS-ACCESS-KEY>
AWS_SECRET_ACCESS_KEY=<YOUR-AWS-SECRET-KEY>

# Application Configuration
NODE_ENV=development
PORT=3000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE-THIS-REDIS-PASSWORD>

# JWT Configuration
JWT_SECRET=<CHANGE-THIS-JWT-SECRET>
JWT_EXPIRATION=7d

# External Services
MSSQL_HOST=<YOUR-MSSQL-HOST>
MSSQL_PORT=1433
MSSQL_DATABASE=<YOUR-MSSQL-DATABASE>
MSSQL_USER=<YOUR-MSSQL-USER>
MSSQL_PASSWORD=<CHANGE-THIS-MSSQL-PASSWORD>

# SCADA Database Configuration
SCADA_DB_HOST=<YOUR-SCADA-HOST>
SCADA_DB_PORT=5432
SCADA_DB_NAME=db_scada
SCADA_DB_USER=<YOUR-SCADA-USER>
SCADA_DB_PASSWORD=<CHANGE-THIS-SCADA-PASSWORD>

# PostGIS Configuration (if different from main Postgres)
POSTGIS_HOST=${EC2_HOST}
POSTGIS_PORT=5432
POSTGIS_DB=gis_db
POSTGIS_USER=postgres
POSTGIS_PASSWORD=<CHANGE-THIS-POSTGIS-PASSWORD>

# API Keys
API_KEY=<YOUR-API-KEY>

