# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files
.env
.env.local
.env.production
.env.test

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
temp/
tmp/
uploads/
*.tmp

# Test files
*.test.js
*.spec.js
# ...except the committed suite under tests/. This blanket rule is why this
# service shipped with no runnable tests: every *.test.js written for it was
# silently untracked.
!tests/**/*.test.js
!tests/**/*.spec.js
# ...but a secret-shaped basename must never ride in on a .test.js suffix.
# This deeper .gitignore wins over the root guards, so re-assert them here.
tests/**/.env*
tests/**/*.pem*
tests/**/*.key*
tests/**/credentials*
tests/**/*secret*
tests/**/*.local.*

# Reports
reports/
*.pdf
*.xlsx
*.csv

# Cache
.cache/
.eslintcache