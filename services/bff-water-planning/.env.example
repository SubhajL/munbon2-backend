# BFF Water Planning Service Configuration
SERVICE_NAME=bff-water-planning
PORT=3022
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
POSTGRES_URL=postgresql://postgres:postgres@localhost:5434/munbon_dev
REDIS_URL=redis://localhost:6379/2

# Mock Server Configuration (for development)
USE_MOCK_SERVER=true
MOCK_SERVER_URL=http://localhost:3099

# External Service URLs (used when USE_MOCK_SERVER=false)
ROS_SERVICE_URL=http://localhost:3047
GIS_SERVICE_URL=http://localhost:3007
AWD_CONTROL_URL=http://localhost:3010
FLOW_MONITORING_URL=http://localhost:3011
SCHEDULER_URL=http://localhost:3021
PLANNING_DEPTH_WRITES_ENABLED=false
PLANNING_DEPTH_WRITE_LIMIT=10
PLANNING_DEPTH_WRITE_WINDOW_SECONDS=300
WEATHER_API_URL=http://localhost:3006

# Database Pool Configuration
# Reduced pool sizes to prevent connection exhaustion on AWS RDS
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=5
DB_POOL_MAX_QUERIES=50000
DB_POOL_MAX_INACTIVE_LIFETIME=300

# Demand Calculation Configuration
DEMAND_COMBINATION_STRATEGY=aquacrop_priority

# CORS Configuration
# For development: allow localhost origins
# For production: MUST be explicit domain list (never use *)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
# DB connection (F-07/SEC: scripts read these instead of hardcoded creds)
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=
