# Smart Farm Water Control Configuration

# Plot Configuration (10-11 plots, ~2.5 rai each)
SMART_FARM_PLOTS=SF01,SF02,SF03,SF04,SF05,SF06,SF07,SF08,SF09,SF10,SF11

# Sensor Mapping - Format: PLOT_ID:SENSOR_TYPE:SENSOR_ID
# AWD Plots (water level sensors)
SF01_SENSORS=AWD:AWD-SF01
SF02_SENSORS=AWD:AWD-SF02
SF03_SENSORS=AWD:AWD-SF03
SF04_SENSORS=AWD:AWD-SF04
SF05_SENSORS=AWD:AWD-SF05

# Moisture Control Plots
SF06_SENSORS=MOISTURE:MOIST-SF06-001
SF07_SENSORS=MOISTURE:MOIST-SF07-001
SF08_SENSORS=MOISTURE:MOIST-SF08-001
SF09_SENSORS=MOISTURE:MOIST-SF09-001
SF10_SENSORS=MOISTURE:MOIST-SF10-001
SF11_SENSORS=MOISTURE:MOIST-SF11-001

# Valve Mapping - Format: PLOT_ID:VALVE_NAME
SF01_VALVE=SV_SF01
SF02_VALVE=SV_SF02
SF03_VALVE=SV_SF03
SF04_VALVE=SV_SF04
SF05_VALVE=SV_SF05
SF06_VALVE=SV_SF06
SF07_VALVE=SV_SF07
SF08_VALVE=SV_SF08
SF09_VALVE=SV_SF09
SF10_VALVE=SV_SF10
SF11_VALVE=SV_SF11

# Control Parameters
MOISTURE_THRESHOLD_PERCENT=12
MOISTURE_HYSTERESIS_PERCENT=2
AWD_MIN_WATER_LEVEL_CM=5
AWD_MAX_WATER_LEVEL_CM=15
AWD_DRYING_PERIOD_DAYS=7

# Database Configuration
# TimescaleDB on AWS
TIMESCALE_HOST=postgres-aws-munbon
TIMESCALE_PORT=5432
TIMESCALE_DB=sensor_data
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=
TIMESCALE_SCHEMA_PLANNING=ros_gis_smartfarm
TIMESCALE_SCHEMA_CONTROL=water_control_smartfarm

# MSSQL for Valve Commands
MSSQL_HOST=moonup.hopto.org
MSSQL_PORT=1433
MSSQL_DB=db_scada
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_TABLE=tb_valve_command_v2

# ROS Integration
ROS_API_URL=http://localhost:3000/api
ROS_API_KEY=

# Control Loop Settings
CONTROL_LOOP_INTERVAL_MINUTES=5
PLANNING_INTERVAL_HOURS=24
WATER_FLOW_RATE_LPM=60  # Liters per minute per valve