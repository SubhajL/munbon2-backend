# Smart Farm Water Control Configuration

# Service Configuration
NODE_ENV=development
PORT=3020
LOG_LEVEL=info

# Plot Configuration (10-11 plots, ~2.5 rai each)
SMART_FARM_PLOTS=SF01,SF02,SF03,SF04,SF05,SF06,SF07,SF08,SF09,SF10,SF11
PLOT_AREA_RAI=2.5

# Sensor Mapping - Format: PLOT_ID:SENSOR_TYPE:SENSOR_ID
# AWD Plots (water level sensors)
SF01_SENSORS=AWD:AWD-SF01
SF02_SENSORS=AWD:AWD-SF02
SF03_SENSORS=AWD:AWD-SF03
SF04_SENSORS=AWD:AWD-SF04
SF05_SENSORS=AWD:AWD-SF05

# Moisture Control Plots
SF06_SENSORS=MOISTURE:MOIST-SF06-001
SF07_SENSORS=MOISTURE:MOIST-SF07-001
SF08_SENSORS=MOISTURE:MOIST-SF08-001
SF09_SENSORS=MOISTURE:MOIST-SF09-001
SF10_SENSORS=MOISTURE:MOIST-SF10-001
SF11_SENSORS=MOISTURE:MOIST-SF11-001

# Valve Mapping - Format: PLOT_ID:VALVE_NAME
SF01_VALVE=SV_SF01
SF02_VALVE=SV_SF02
SF03_VALVE=SV_SF03
SF04_VALVE=SV_SF04
SF05_VALVE=SV_SF05
SF06_VALVE=SV_SF06
SF07_VALVE=SV_SF07
SF08_VALVE=SV_SF08
SF09_VALVE=SV_SF09
SF10_VALVE=SV_SF10
SF11_VALVE=SV_SF11

# Control Parameters
# Moisture Control - Dual Threshold System
MOISTURE_THRESHOLD_LOW_PERCENT=10    # Turn ON valve when moisture < this value
MOISTURE_THRESHOLD_HIGH_PERCENT=15   # Turn OFF valve when moisture > this value

# AWD Control Parameters
AWD_MIN_WATER_LEVEL_CM=5            # Minimum water level before irrigation
AWD_MAX_WATER_LEVEL_CM=15           # Maximum water level target
AWD_DRYING_PERIOD_DAYS=7            # Days between drying cycles

# Database Configuration
# TimescaleDB on AWS
TIMESCALE_HOST=postgres-aws-munbon.region.rds.amazonaws.com
TIMESCALE_PORT=5432
TIMESCALE_DB=sensor_data
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=
TIMESCALE_SCHEMA_PLANNING=ros_gis_smartfarm
TIMESCALE_SCHEMA_CONTROL=water_control_smartfarm

# MSSQL for Valve Commands
MSSQL_HOST=moonup.hopto.org
MSSQL_PORT=1433
MSSQL_DB=db_scada
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_TABLE_VALVE_COMMAND=tb_valve_command_v2

# ROS Integration
ROS_API_URL=http://localhost:3001/api
ROS_API_KEY=
ROS_CALCULATION_ENDPOINT=/calculate-water-demand

# Control Loop Settings
CONTROL_LOOP_INTERVAL_MINUTES=5      # Check sensors and control valves every 5 minutes
PLANNING_INTERVAL_HOURS=24          # Calculate water demand daily
WATER_FLOW_RATE_LPM=60             # Liters per minute per valve

# Sensor Data Service Integration
SENSOR_DATA_SERVICE_URL=http://localhost:3005
SENSOR_DATA_API_KEY=