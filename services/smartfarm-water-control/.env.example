# Smart Farm Water Control Configuration

# Service Configuration
NODE_ENV=development
PORT=3020
LOG_LEVEL=info

# Plot Configuration (GeoJSON-based)
# Plot geometries and areas are loaded from data/smartfarm-plots.geojson
# Control modes are stored in TimescaleDB water_control_smartfarm.control_modes table
# Only configure sensor/valve mappings here
#
# Format: plotId:sensorId:valveName
# Multiple plots separated by commas
# Plot IDs must match crop_id values in the GeoJSON file
#
# Example:
# PLOT_CONFIGS=fbd7920c-1a05-487c-a79e-a4003ab30be9:AWD-SF01:SV_SF01,535d0d0b-afdb-49f2-85dd-74c13ee7b561:MOIST-SF02:SV_SF02
#
# NOTE: Control modes (AWD/MOISTURE) are now stored in the database.
# Use scripts/seed-control-modes.js to configure control modes for each plot.
# See README.md for database-based control mode management.
#
# Available plots from GeoJSON (12 total):
# - fbd7920c-1a05-487c-a79e-a4003ab30be9 (2.51 rai)
# - 535d0d0b-afdb-49f2-85dd-74c13ee7b561 (2.18 rai)
# - 7072584e-e3cd-4bcc-9221-7a3a23386d2a (5.37 rai)
# - 5ea77d99-c3fa-43f5-9087-be15de92d615 (1.13 rai)
# - aabb24c1-b673-42f3-b90a-56f3d81d53a8 (1.17 rai)
# - cc74748e-1c92-4d06-9376-df96924eef4f (1.24 rai)
# - f0b3c562-6060-4ebd-897d-d47b642f8d23 (1.24 rai)
# - 491f0baf-452a-437a-ab0c-68b621ba5922 (2.7 rai)
# - 5177f028-0209-47dd-a9a3-36a9e73f239d (2.03 rai)
# - 6ab85dc0-7486-42ca-a7e1-62d4f2e80bd1 (2.68 rai)
# - 7012604e-07d7-4223-843f-c16bb4727843 (2.03 rai)
# - c34e125d-805a-4bc3-a0f6-7ba717a47f28 (2.6 rai)
#
PLOT_CONFIGS=

# Control Parameters
# Moisture Control - Dual Threshold System
MOISTURE_THRESHOLD_LOW_PERCENT=50    # Turn ON valve when moisture < this value
MOISTURE_THRESHOLD_HIGH_PERCENT=69   # Turn OFF valve when moisture > this value

# AWD Control Parameters
AWD_MIN_WATER_LEVEL_CM=-10          # Begin irrigation when water level drops below this value
AWD_MAX_WATER_LEVEL_CM=10           # Stop irrigation when water level rises above this value
AWD_DRYING_PERIOD_DAYS=7            # Days between drying cycles

# Database Configuration
# TimescaleDB on AWS
TIMESCALE_HOST=postgres-aws-munbon.region.rds.amazonaws.com
TIMESCALE_PORT=5432
TIMESCALE_DB=sensor_data
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=
TIMESCALE_SCHEMA_PLANNING=ros_gis_smartfarm
TIMESCALE_SCHEMA_CONTROL=water_control_smartfarm

# MSSQL for Valve Commands
MSSQL_HOST=moonup.hopto.org
MSSQL_PORT=1433
MSSQL_DB=db_scada
MSSQL_USER=
MSSQL_PASSWORD=
# Valve command table name - switch to tb_valve_command_v2_test for testing
# Production: tb_valve_command_v2
# Test mode:  tb_valve_command_v2_test (see docs/TEST_MODE_SETUP.md)
MSSQL_TABLE_VALVE_COMMAND=tb_valve_command_v2

# ROS Integration
ROS_API_URL=http://localhost:3001/api
ROS_API_KEY=
ROS_CALCULATION_ENDPOINT=/calculate-water-demand

# Control Loop Settings
CONTROL_LOOP_INTERVAL_MINUTES=5      # Check sensors and control valves every 5 minutes
PLANNING_INTERVAL_HOURS=24          # Calculate water demand daily
WATER_FLOW_RATE_LPM=60             # Liters per minute per valve

# Sensor Data Service Integration
SENSOR_DATA_SERVICE_URL=http://localhost:3005
SENSOR_DATA_API_KEY=

# Real-Time Sensor Update Listener
# Enables PostgreSQL LISTEN/NOTIFY for near real-time plot processing
# When enabled, the service reacts immediately to new sensor readings via database triggers
# The cron-based control loop remains active as a safety net
ENABLE_DB_LISTENER=false                # Set to "true" to enable real-time processing
LISTENER_RECONNECT_DELAY_MS=5000        # Delay before reconnection attempts (milliseconds)
LISTENER_DEBOUNCE_WINDOW_MS=5000        # Debounce duplicate notifications (milliseconds)
