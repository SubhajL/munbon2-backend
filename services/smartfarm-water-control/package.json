{
  "name": "@munbon/smartfarm-water-control",
  "version": "1.0.0",
  "description": "Smart farm water planning and control system with ROS integration",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js,.ts",
    "typecheck": "tsc --noEmit",
    "db:init": "node src/config/database.js",
    "setup": "./scripts/quick-start.sh",
    "test:integration": "node scripts/setup-databases.js && node scripts/test-ros-integration.js && node scripts/test-sensor-integration.js",
    "test:db": "node scripts/setup-databases.js",
    "test:ros": "node scripts/test-ros-integration.js",
    "test:sensors": "node scripts/test-sensor-integration.js"
  },
  "keywords": [
    "smart-farm",
    "water-control",
    "irrigation",
    "awd",
    "moisture-control"
  ],
  "author": "Munbon Team",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "mssql": "^10.0.1",
    "node-cron": "^3.0.2",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/pg": "^8.10.9",
    "@types/mssql": "^9.1.4",
    "@types/node-cron": "^3.0.10",
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.spec.js", "**/*.spec.ts"],
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "!src/**/*.d.ts",
      "!src/index.js"
    ]
  }
}