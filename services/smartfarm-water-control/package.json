{
  "name": "@munbon/smartfarm-water-control",
  "version": "1.0.0",
  "description": "Smart farm water planning and control system with ROS integration",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node src/index.js",
    "restart": "bash scripts/kill-port.sh 3020 && node src/index.js",
    "kill-port": "bash scripts/kill-port.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js,.ts",
    "typecheck": "tsc --noEmit",
    "db:init": "node src/config/database.js",
    "setup": "./scripts/quick-start.sh",
    "test:integration": "node scripts/setup-databases.js && node scripts/test-ros-integration.js && node scripts/test-sensor-integration.js",
    "test:db": "node scripts/setup-databases.js",
    "test:ros": "node scripts/test-ros-integration.js",
    "test:sensors": "node scripts/test-sensor-integration.js",
    "analysis": "node scripts/run-analysis-workflow.js",
    "analysis:inspect": "node scripts/run-analysis-workflow.js 30 --inspect-test-table",
    "analysis:weekly": "node scripts/run-analysis-workflow.js 7",
    "listen-worker": "node scripts/listen-worker.js",
    "worker": "node scripts/listen-worker.js",
    "import:smartfarm-shape": "node scripts/import-smartfarm-shape.js",
    "db:create-tables": "node scripts/create-smartfarm-tables.js",
    "db:create-views": "node scripts/create-smartfarm-views.js",
    "verify:smartfarm-ingest": "node scripts/verify-smartfarm-ingest.js",
    "db:reset-smartfarm": "node scripts/reset-smartfarm-config.js",
    "map:sensors": "node scripts/map-sensors-to-plots.js",
    "seed:classification": "node scripts/seed-smartfarm-classification.js",
    "migrate:allow-garden": "node scripts/migrations/allow-garden-croptype.js",
    "listener:waterlevel-locations": "node scripts/run-waterlevel-listener.js",
    "import:moisture-zip": "node scripts/import-moisture-sensors-from-zip.js",
    "workers:smartfarm": "node scripts/start-smartfarm-workers.js"
  },
  "keywords": [
    "smart-farm",
    "water-control",
    "irrigation",
    "awd",
    "moisture-control"
  ],
  "author": "Munbon Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mssql": "^10.0.1",
    "node-cron": "^3.0.2",
    "pg": "^8.11.3",
    "proj4": "^2.19.10",
    "shapefile": "^0.6.6",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/mssql": "^9.1.4",
    "@types/node": "^20.9.0",
    "@types/node-cron": "^3.0.10",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "fast-check": "^4.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.spec.js",
      "**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts}",
      "!src/**/*.d.ts",
      "!src/index.js"
    ]
  }
}
