{
  "name": "@munbon/pm2-infrastructure",
  "version": "1.0.0",
  "description": "PM2 ecosystem configuration for irrigation canal services",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format:check": "prettier --check \"*.{ts,js,json,md}\" \"__tests__/*.ts\"",
    "format": "prettier --write \"*.{ts,js,json,md}\" \"__tests__/*.ts\"",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "preflight": "node dist/deploy-preflight-cli.js",
    "collect-evidence": "node dist/collect-control-plane-evidence.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "jest": "^29.7.0",
    "prettier": "3.9.6",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
