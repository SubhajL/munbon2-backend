{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munbon.rid.go.th/contracts/rid-calendar/v1/irrigation-week.schema.json",
  "title": "Irrigation week identity vectors",
  "description": "Golden vectors mapping a civil date to its administrative irrigation year and week. Every implementation in every language MUST reproduce these exactly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_family", "contract_version", "vector_kind", "vectors"],
  "properties": {
    "contract_family": { "const": "rid-calendar" },
    "contract_version": { "const": 1 },
    "vector_kind": { "const": "irrigation-week" },
    "vectors": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "irrigation_year",
          "irrigation_week",
          "week_key",
          "week_start",
          "week_end",
          "week_length_days",
          "iso_week",
          "iso_year",
          "note"
        ],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "irrigation_year": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ce", "be"],
            "properties": {
              "ce": { "type": "integer", "minimum": 1901, "maximum": 2401 },
              "be": { "type": "integer", "minimum": 2444, "maximum": 2944 }
            }
          },
          "irrigation_week": { "type": "integer", "minimum": 1, "maximum": 53 },
          "week_key": { "type": "string", "pattern": "^[0-9]{4}-R[0-9]{2}$" },
          "week_start": { "type": "string", "format": "date" },
          "week_end": { "type": "string", "format": "date" },
          "week_length_days": { "type": "integer", "minimum": 1, "maximum": 7 },
          "iso_week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 53,
            "description": "The ISO-8601 week for the same date. Recorded for contrast only — it is NOT the irrigation answer and MUST NOT be used as one."
          },
          "iso_year": { "type": "integer" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
