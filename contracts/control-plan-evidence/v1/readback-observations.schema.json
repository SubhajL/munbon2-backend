{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munbon.internal/contracts/control-plan-evidence/v1/readback-observations.schema.json",
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_gate_id": {
          "type": "string"
        },
        "observed_level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_level": {
          "type": "integer"
        },
        "quality": {
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "ok",
            "mismatch",
            "unavailable"
          ]
        },
        "reconciliation_mode": {
          "type": "string",
          "enum": [
            "observe",
            "enforce"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "canonical_gate_id",
        "observed_level",
        "expected_level",
        "quality",
        "verdict",
        "reconciliation_mode",
        "observed_at"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_version": {
      "type": "integer"
    },
    "observations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "required": [
    "plan_id",
    "plan_version",
    "observations"
  ]
}
