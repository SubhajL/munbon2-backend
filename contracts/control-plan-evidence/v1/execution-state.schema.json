{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munbon.internal/contracts/control-plan-evidence/v1/execution-state.schema.json",
  "$defs": {
    "hold_event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "held",
            "resumed"
          ]
        },
        "worker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "event_type",
        "worker_id",
        "occurred_at"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_version": {
      "type": "integer"
    },
    "is_held": {
      "type": "boolean"
    },
    "hold_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hold_event"
      }
    }
  },
  "required": [
    "plan_id",
    "plan_version",
    "is_held",
    "hold_events"
  ]
}
