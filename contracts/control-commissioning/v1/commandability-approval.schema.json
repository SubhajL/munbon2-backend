{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munbon.internal/contracts/control-commissioning/v1/commandability-approval.schema.json",
  "title": "HydraulicCommandabilityApprovalV1",
  "description": "External content-addressed approval overlay. A base engineering-prior release remains noncommandable; only an approved, runtime-cross-bound overlay permits snapshot v4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_state",
    "base_model_release",
    "prediction_engine",
    "model_config_sha256",
    "operating_envelope",
    "device_capability",
    "approval",
    "content_hash"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "approval_state": { "enum": ["approved", "not_approved"] },
    "base_model_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "content_hash"],
      "properties": {
        "release_id": { "$ref": "#/$defs/release_id" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "prediction_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash"],
      "properties": {
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "model_config_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "canal_geometry",
        "gate_calibrations",
        "geometry_coverage",
        "routing_topology"
      ],
      "properties": {
        "network": { "$ref": "#/$defs/sha256" },
        "canal_geometry": { "$ref": "#/$defs/sha256" },
        "gate_calibrations": { "$ref": "#/$defs/sha256" },
        "geometry_coverage": { "$ref": "#/$defs/sha256" },
        "routing_topology": { "$ref": "#/$defs/sha256" }
      }
    },
    "operating_envelope": { "$ref": "#/$defs/operating_envelope" },
    "device_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_release_id",
        "capability_hash",
        "approved_gate_ids"
      ],
      "properties": {
        "capability_release_id": { "$ref": "#/$defs/release_id" },
        "capability_hash": { "$ref": "#/$defs/sha256" },
        "approved_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_blank" }
        }
      }
    },
    "approval": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/attestation" }
      ]
    },
    "content_hash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "approval_state": { "const": "approved" } },
        "required": ["approval_state"]
      },
      "then": { "properties": { "approval": { "$ref": "#/$defs/attestation" } } },
      "else": { "properties": { "approval": { "type": "null" } } }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "non_blank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": ".*\\S.*"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "operating_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_flow_m3s",
        "maximum_flow_m3s",
        "minimum_timestep_seconds",
        "maximum_timestep_seconds",
        "maximum_horizon_seconds"
      ],
      "properties": {
        "minimum_flow_m3s": { "type": "number", "minimum": 0 },
        "maximum_flow_m3s": { "type": "number", "exclusiveMinimum": 0 },
        "minimum_timestep_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_timestep_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_horizon_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "sha256"],
      "properties": {
        "kind": { "$ref": "#/$defs/non_blank" },
        "reference": { "$ref": "#/$defs/non_blank" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by_role",
        "approved_at",
        "approval_reference",
        "evidence"
      ],
      "properties": {
        "approved_by_role": { "$ref": "#/$defs/non_blank" },
        "approved_at": { "type": "string", "format": "date-time" },
        "approval_reference": { "$ref": "#/$defs/non_blank" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
