{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munbon.example/contracts/planning-depth-submissions/v1/submission-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "client_submission_id",
    "project_key",
    "week_key",
    "week_date",
    "submitted_at",
    "submitted_by",
    "supersedes_submission_id",
    "request_sha256",
    "replayed"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "client_submission_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_key": {
      "const": "mun-bon"
    },
    "week_key": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "week_date": {
      "type": "string",
      "format": "date"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "submitted_by": {
      "type": "string",
      "minLength": 1
    },
    "supersedes_submission_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replayed": {
      "type": "boolean"
    }
  }
}
